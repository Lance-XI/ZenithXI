Stat Multiplier Scaling
Applies era stat bonus scaling up to level 37 and custom formula from 37 and above
- Below level 37: returns startValue
- At level 75+: returns endValue
- Between 37-74: linearly interpolates

This patch implements era-accurate stat-to-combat scaling for players based on level progression.
---
diff --git a/src/map/entities/battle_entity.cpp b/src/map/entities/battle_entity.cpp
index 0b5d6bb281..71c26dabf9 100644
--- a/src/map/entities/battle_entity.cpp
+++ b/src/map/entities/battle_entity.cpp
@@ -63,6 +63,20 @@
 #include "utils/zoneutils.h"
 #include "weapon_skill.h"
 
+static float GetEraScaledMultiplier(uint8 level, float startValue, float endValue)
+{
+    if (level < 37)
+    {
+        return startValue;
+    }
+    else if (level >= 75)
+    {
+        return endValue;
+    }
+
+    return startValue + (endValue - startValue) * ((level - 37) / 38.0f);
+}
