Restore the pre-2014 requirement that a Beastmaster jug pet must have 1000 TP
(100%) before it can execute a "Ready" move (Foot Kick ... Pentapeck).

The individual Ready moves are player-triggered pet abilities dispatched in
CCharEntity::OnAbility with no TP check, so a jug pet could use TP moves at 0 TP
until its charges ran out. Sic already gates on 1000 TP in Lua (useSic); this
adds the matching gate for Ready at the single C++ chokepoint. Blocked attempts
push MsgBasic::PetNotEnoughTP and return before the charge is consumed, so no
charge is wasted. Scoped to JUG_PET so SMN/DRG/PUP pets are unaffected.
---
diff --git a/src/map/entities/char_entity.cpp b/src/map/entities/char_entity.cpp
--- a/src/map/entities/char_entity.cpp
+++ b/src/map/entities/char_entity.cpp
@@ -1784,6 +1784,20 @@ void CCharEntity::OnAbility(CAbilityState& state, action_t& action)
         return;
     }
 
+    // Restore pre-2014 behaviour: a jug pet must have full TP (>= 1000, i.e. 100%)
+    // before it can perform a Ready move. Sic already enforces this in Lua (useSic);
+    // the individual Ready moves (Foot Kick ... Pentapeck) never checked pet TP, so a
+    // jug pet could use TP moves at 0 TP until its charges ran out.
+    if (PAbility->isPetAbility())
+    {
+        auto* PPetEntity = dynamic_cast<CPetEntity*>(PPet);
+        if (PPetEntity != nullptr && PPetEntity->getPetType() == PET_TYPE::JUG_PET && PPetEntity->health.tp < 1000)
+        {
+            pushPacket<GP_SERV_COMMAND_BATTLE_MESSAGE>(this, this, 0, 0, MsgBasic::PetNotEnoughTP);
+            return;
+        }
+    }
+
     uint8 findFlags = 0;
 
     if ((PAbility->getValidTarget() & TARGET_PLAYER_DEAD) == TARGET_PLAYER_DEAD)
